{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Neut",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.neut"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "((?<![-A-Za-z0-9_.])(?:alias|alias-opaque|constant|data|define|define-meta|inline|inline-meta|memoize|resource|rule-left|rule-right)(?![-A-Za-z0-9_.]))\\s+([^\\s:\\n({<\\[\\])}>,]+)",
          "name": "meta.declaration.neut",
          "captures": {
            "1": {
              "name": "keyword.declaration.neut"
            },
            "2": {
              "name": "entity.name.function.neut"
            }
          }
        },
        {
          "match": "(?<![-A-Za-z0-9_.])(?:alias|alias-opaque|bind|box|case|constant|data|default|define|define-meta|else|else-if|exact|external|foreign|if|import|inline|inline-meta|introspect|let|letbox|letbox-T|lift|match|memoize|nominal|on|pack-type|pin|promote|quote|resource|rule-left|rule-right|tie|try|unbox|unpack-type|unquote|when|with)(?![-A-Za-z0-9_.])",
          "name": "keyword.neut"
        },
        {
          "match": "(?<![-A-Za-z0-9_.])(?:_|assert|magic|static|text-file)(?![-A-Za-z0-9_.])",
          "name": "keyword.builtin.neut"
        },
        {
          "match": "(?:=>>|->>|=>|->|=)",
          "name": "keyword.operator.arrow.neut"
        },
        {
          "match": "(?<![-A-Za-z0-9_.])admit(?![-A-Za-z0-9_.])",
          "name": "invalid.deprecated.admit.neut"
        },
        {
          "match": "(?<![-A-Za-z0-9_.])this(?![-A-Za-z0-9_.])",
          "name": "constant.language.this.neut"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "(?<![-A-Za-z0-9_.])(?:pointer|rune|type|void)(?![-A-Za-z0-9_.])",
          "name": "support.type.neut"
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "match": "(?<![-A-Za-z0-9_.])_?\\.?[A-Z][-A-Za-z0-9_]*(?![-A-Za-z0-9_.])",
          "name": "support.type.neut"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.neut",
          "patterns": [
            {
              "match": "\\\\(?:[0tnr\"\\\\`]|u\\{[0-9A-F]+\\})",
              "name": "constant.character.escape.neut"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.neut"
            }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "constant.character.rune.neut",
          "patterns": [
            {
              "match": "\\\\(?:[0tnr\"\\\\`]|u\\{[0-9A-F]+\\})",
              "name": "constant.character.escape.neut"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.neut"
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "[\\\\*|!,:+&@?;'$^#~]",
          "name": "keyword.operator.neut"
        }
      ]
    }
  },
  "scopeName": "source.neut"
}
