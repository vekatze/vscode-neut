{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Neut",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-dash.neut"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword",
          "match": "(\\s|^)(data|define|inline|resource)\\s([^(:<{]+)",
          "captures": {
            "3": {
              "name": "support.function"
            }
          }
        },
        {
          "match": "(\\s|^)(attach|bind|box|case|data|default|define|detach|do|else|else-if|exact|external|foreign|function|if|import|inline|introspect|let|letbox|letbox-T|match|nominal|of|on|pin|quote|resource|tie|try|use|when|with)(?=\\s|$)",
          "name": "keyword.neut"
        },
        {
          "match": "(\\s|^)(assert|magic|include-text|static)(?=\\s|$)",
          "name": "keyword.builtin.neut"
        },
        {
          "match": "(\\s|^)(admit)(?=\\s|$)",
          "name": "support"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.neut",
          "match": "(\\s|^)(type|thread|meta|rune|void|pointer)(?=\\s|$)"
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "name": "support.type.neut",
          "match": "(\\s|^)(_*[A-Z][^\\s(\\.]*)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.neut",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neut",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.neut",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.neut",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "support",
          "match": "(->|:|=>|=|_|,|;|:|::|!|&|\\?|\\*|\\+|\\|)"
        }
      ]
    }
  },
  "scopeName": "source.neut"
}
